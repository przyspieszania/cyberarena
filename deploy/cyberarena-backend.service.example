[Unit]
Description=CyberArena backend (Node.js/Express)
After=network.target postgresql.service

[Service]
Type=simple
User=cyberarena
WorkingDirectory=/var/www/cyberarena/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/var/www/cyberarena/backend/.env

# Utwardzenie (defense-in-depth na poziomie systemd)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/cyberarena/backend
ProtectHome=true

[Install]
WantedBy=multi-user.target
